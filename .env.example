# Copy to .env for local use. .env is ignored by git; never commit secrets.

# Settings module: config.settings.local, config.settings.test or config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# Required in production; local falls back to a throwaway value
# DJANGO_SECRET_KEY=
# Debug mode (local only; production is always off)
DJANGO_DEBUG=true
# Allowed Host headers, comma separated (required in production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Redirect HTTP to HTTPS (production only, default on)
DJANGO_SECURE_SSL_REDIRECT=false
# Database URL; defaults to the local server from compose.yaml
DATABASE_URL=postgres://ke:ke@localhost:5432/ke
# Host port of the compose database
DB_PORT=5432
# Origins of the UI, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Sign-in mode: entra or dev (dev is refused in production)
AUTH_MODE=dev
# Entra app registration ids (not secrets)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Scope a token must carry
ENTRA_REQUIRED_SCOPE=access_as_user
# Private key of the local dev token issuer (AUTH_MODE=dev only); created on first use, keep it out of git
# Default: .dev-keys/issuer.pem in the project directory
# DEV_AUTH_KEY_PATH=/absolute/path/issuer.pem
# Log level
LOG_LEVEL=INFO
# Log format: json or console
LOG_FORMAT=console
# Serve the schema and Swagger UI
API_DOCS_ENABLED=true
# Redis URL: channel layer for live updates
REDIS_URL=redis://localhost:6379/0
# Host port of the compose Redis
REDIS_PORT=6379
# Lifetime of a socket ticket, in seconds
WS_TICKET_TTL_SECONDS=30
# Where the document list comes from: samples (later http)
DOCUMENT_CATALOG=samples
# The catalog service URL, for DOCUMENT_CATALOG=http
DOCUMENT_CATALOG_URL=
# Where document content is read: samples (later azure)
DOCUMENT_STORAGE=samples
# The storage account URL, for DOCUMENT_STORAGE=azure
AZURE_STORAGE_ACCOUNT_URL=
# Assistant agent: scripted or openai
ASSISTANT_AGENT=scripted
# Extractor: scripted
EXTRACTOR=scripted
# LLM provider: openai or azure
LLM_PROVIDER=openai
# Model or deployment name
LLM_MODEL=
# Secret, for LLM_PROVIDER=openai; set in your own .env only
OPENAI_API_KEY=
# For LLM_PROVIDER=azure: signs in with the app's identity, no key
AZURE_OPENAI_ENDPOINT=
# true turns telemetry off
OTEL_SDK_DISABLED=true
# Service name on telemetry
OTEL_SERVICE_NAME=knowledge-extractor-api
# Where telemetry goes (OTLP over HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Extra resource attributes, comma separated key=value
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
