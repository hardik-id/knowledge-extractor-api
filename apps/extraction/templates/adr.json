{
  "id": "adr",
  "name": "Architecture decision records",
  "description": "One architecture decision record per record: title, status, date, approvers, context and decision.",
  "definition": {
    "prompt": "Extract every architecture decision record (ADR) in the document.",
    "record_types": [
      {
        "id": "rt-adr",
        "name": "ADR",
        "description": "One architecture decision record: a titled decision with its context.",
        "fields": [
          {
            "id": "f-adr-title",
            "key": "title",
            "name": "Title",
            "description": "The title of the decision.",
            "mode": "quote",
            "value_type": "text",
            "choices": [],
            "multiple": false
          },
          {
            "id": "f-adr-status",
            "key": "status",
            "name": "Status",
            "description": "Where the decision stands.",
            "mode": "inferred",
            "value_type": "choice",
            "choices": [
              "proposed",
              "accepted",
              "superseded",
              "rejected"
            ],
            "multiple": false
          },
          {
            "id": "f-adr-decided-on",
            "key": "decided_on",
            "name": "Decided on",
            "description": "The date the decision was made.",
            "mode": "inferred",
            "value_type": "date",
            "choices": [],
            "multiple": false
          },
          {
            "id": "f-adr-approved-by",
            "key": "approved_by",
            "name": "Approved by",
            "description": "The people who approved the decision.",
            "mode": "quote",
            "value_type": "text",
            "choices": [],
            "multiple": true
          },
          {
            "id": "f-adr-context",
            "key": "context",
            "name": "Context",
            "description": "Why the decision was needed.",
            "mode": "quote",
            "value_type": "text",
            "choices": [],
            "multiple": false
          },
          {
            "id": "f-adr-decision",
            "key": "decision",
            "name": "Decision",
            "description": "What was decided.",
            "mode": "quote",
            "value_type": "text",
            "choices": [],
            "multiple": false
          }
        ]
      }
    ],
    "output": {
      "format": "markdown",
      "template": "## {{title}}\n\n**Status:** {{status}}\n**Decided on:** {{decided_on}}\n**Approved by:**\n{{#approved_by}}- {{.}}\n{{/approved_by}}\n### Context\n\n{{context}}\n\n### Decision\n\n{{decision}}\n"
    }
  }
}
