# Copy to .env for local use. .env is ignored by git; never commit secrets.

# Settings module: config.settings.local, config.settings.test or config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# Required in production; local falls back to a throwaway value
DJANGO_SECRET_KEY=
# Debug mode (local only; production is always off)
DJANGO_DEBUG=true
# Allowed Host headers, comma separated (required in production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Redirect HTTP to HTTPS (production only, default on)
DJANGO_SECURE_SSL_REDIRECT=false
# Database URL; defaults to the SQLite file db.sqlite3 until PostgreSQL arrives
DATABASE_URL=sqlite:///db.sqlite3
# Origins of the UI, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Sign-in mode: entra or dev (dev is refused in production)
AUTH_MODE=dev
# Entra app registration ids (not secrets)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Scope a token must carry
ENTRA_REQUIRED_SCOPE=access_as_user
# Log level
LOG_LEVEL=INFO
# Log format: json or console
LOG_FORMAT=console
# Serve the schema and Swagger UI
API_DOCS_ENABLED=true
