# Copy to .env for local use. .env is ignored by git; never commit secrets.

# Settings module: config.settings.local, config.settings.test or config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# Required in production; local falls back to a throwaway value
# DJANGO_SECRET_KEY=
# Debug mode (local only; production is always off)
DJANGO_DEBUG=true
# Allowed Host headers, comma separated (required in production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Redirect HTTP to HTTPS (production only, default on)
DJANGO_SECURE_SSL_REDIRECT=false
# Database URL; defaults to the local server from compose.yaml
DATABASE_URL=postgres://ke:ke@localhost:5432/ke
# Host port of the compose database
DB_PORT=5432
# Origins of the UI, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Sign-in mode: entra or dev (dev is refused in production)
AUTH_MODE=dev
# Entra app registration ids (not secrets)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Scope a token must carry
ENTRA_REQUIRED_SCOPE=access_as_user
# Private key of the local dev token issuer (AUTH_MODE=dev only); created on first use, keep it out of git
# Default: .dev-keys/issuer.pem in the project directory
# DEV_AUTH_KEY_PATH=/absolute/path/issuer.pem
# Log level
LOG_LEVEL=INFO
# Log format: json or console
LOG_FORMAT=console
# Serve the schema and Swagger UI
API_DOCS_ENABLED=true
# Redis URL: channel layer for live updates
REDIS_URL=redis://localhost:6379/0
# Host port of the compose Redis
REDIS_PORT=6379
# Lifetime of a socket ticket, in seconds
WS_TICKET_TTL_SECONDS=30
# true serves the echo socket /ws/test/ that proves the wiring; leave it off
REALTIME_TEST_ROUTE=false
# Where the document list comes from: samples (later http)
DOCUMENT_CATALOG=samples
# The catalog service URL, for DOCUMENT_CATALOG=http
DOCUMENT_CATALOG_URL=
# Where document content is read: samples (later azure)
DOCUMENT_STORAGE=samples
# The storage account URL, for DOCUMENT_STORAGE=azure
AZURE_STORAGE_ACCOUNT_URL=
# Assistant agent: scripted or openai
ASSISTANT_AGENT=scripted
# Seconds after which a reply still being written is closed (its worker died)
ASSISTANT_REPLY_TIMEOUT_SECONDS=300
# Extractor: scripted, or llm (calls the model of LLM_PROVIDER and LLM_MODEL)
EXTRACTOR=scripted
# EXTRACTOR=llm: seconds one model call may take
EXTRACTION_MODEL_TIMEOUT_SECONDS=120
# EXTRACTOR=llm: the most tokens the model may answer with
EXTRACTION_MAX_OUTPUT_TOKENS=16000
# EXTRACTOR=llm: the most document characters sent in one call (a longer document is split)
EXTRACTION_CHUNK_CHARS=8000
# EXTRACTOR=llm: the most parts of one document (more fails)
EXTRACTION_MAX_CHUNKS=10
# EXTRACTOR=llm: how many model calls of one file run at a time
EXTRACTION_CONCURRENCY=4
# EXTRACTOR=llm: seconds for all the calls of one file (keep below EXECUTION_TIMEOUT_SECONDS)
EXTRACTION_FILE_TIMEOUT_SECONDS=480
# EXTRACTOR=llm: the most characters of the whole message (definition, examples, document)
EXTRACTION_MAX_INPUT_CHARS=60000
# Seconds after which a queued or running cell counts as failed (a dead worker)
EXECUTION_TIMEOUT_SECONDS=600
# LLM provider: openai, azure or anthropic (anthropic: local testing only)
LLM_PROVIDER=openai
# Model or deployment name (anthropic: claude-haiku-5-5)
LLM_MODEL=
# Secret, for LLM_PROVIDER=openai; set in your own .env only
OPENAI_API_KEY=
# For LLM_PROVIDER=azure: signs in with the app's identity, no key
AZURE_OPENAI_ENDPOINT=
# For LLM_PROVIDER=anthropic: after `ant auth login` no key is needed. A Console key
# (secret, your own .env only) is for containers, which do not see the login
ANTHROPIC_API_KEY=
# Anthropic's OpenAI-compatible endpoint; change it for a gateway
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# true turns telemetry off
OTEL_SDK_DISABLED=true
# Service name on telemetry
OTEL_SERVICE_NAME=knowledge-extractor-api
# Where telemetry goes (OTLP over HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Extra resource attributes, comma separated key=value
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# Where logs go besides stdout: none, or otlp (same endpoint as above)
OTEL_LOGS_EXPORTER=none
# Host ports of the compose collector (OTLP gRPC and HTTP)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Splunk Observability Cloud, for traces and metrics. Secret: set in your own .env only
SPLUNK_ACCESS_TOKEN=
SPLUNK_REALM=
# Splunk Enterprise or Splunk Cloud HEC, for logs. Secret: set in your own .env only
# Example: https://splunk.example.com:8088/services/collector
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
# Index and sourcetype of the log events
SPLUNK_INDEX=main
SPLUNK_SOURCETYPE=knowledge-extractor-api
# true skips certificate checks of the HEC endpoint (a local Splunk only)
SPLUNK_HEC_INSECURE_SKIP_VERIFY=false
